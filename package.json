{
  "name": "hook-inspector",
  "version": "1.0.0",
  "description": "Local hook inspector with automatic formatting and Claude Code integration",
  "scripts": {
    "build": "tsc && esbuild src/client.ts --bundle --format=esm --target=es2022 --outfile=dist/public/app.js",
    "typecheck": "tsc --noEmit",
    "start": "node dist/src/manage.js start",
    "hooks:install": "node dist/src/manage.js install",
    "hooks:uninstall": "node dist/src/manage.js uninstall",
    "test": "npm run build && node --test dist/tests/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sham-33/hook-inspector.git"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "bugs": {
    "url": "https://github.com/sham-33/hook-inspector/issues"
  },
  "homepage": "https://github.com/sham-33/hook-inspector#readme",
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
}
